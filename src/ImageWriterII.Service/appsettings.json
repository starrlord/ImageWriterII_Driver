{
  // ImageWriter II IPP Everywhere service configuration.
  // Edit, then restart the service (Restart-Service ImageWriterII) or the console process.
  "ImageWriter": {
    "PrinterName": "ImageWriter II",
    "MakeAndModel": "Apple ImageWriter II",
    "Location": "",

    // DNS-SD host label: the printer answers as <HostName>.local. Keep it unique on your LAN.
    "HostName": "imagewriter-ii",
    "HttpPort": 631,
    "MdnsEnabled": true,
    // Advertise only on adapters whose name/description contains one of these strings (empty = all).
    "MdnsInterfaces": [],
    // Raw "JetDirect" socket for old software; accepts PWG/URF raster, native ImageWriter data or text.
    "RawPortEnabled": true,
    "RawPort": 9100,

    "Serial": {
      "PortName": "COM1",
      // 300, 1200, 2400 or 9600 (DIP switches SW2-1 / SW2-2; factory setting 9600 = both closed).
      "BaudRate": 9600,
      // Auto = at open, use whichever of CTS / DSR / DCD carries the printer's DTR (ready) signal (SW2-3 open, factory).
      // RequestToSend = CTS, DataSetReady = DSR, DataCarrierDetect = DCD (software-gated), XOnXOff = SW2-3 closed,
      // RequestToSendXOnXOff = both, None = no flow control (data loss unless you also set MaxBytesPerSecond).
      // Run "iwprint status" to see the lines on your cable.
      "Handshake": "Auto",
      "AssertDtr": true,
      "AssertRts": true,
      // Milliseconds; 0 = wait forever (an offline / paper-out printer just pauses the job).
      "WriteTimeoutMs": 0,
      // Pace output for adapters that mishandle flow control. 0 = disabled.
      "MaxBytesPerSecond": 0,
      // NUL bytes appended after each job for USB adapters that hold the last bytes (0 = disabled).
      "TrailingNulPadding": 0
    },

    // Which ribbon is fitted: Color (default), Black, or Auto.
    //   Color = four-colour ribbon; colour jobs are separated into yellow/magenta/cyan/black passes.
    //   Black = black ribbon only; every job prints as one black pass.
    //   Auto  = ask the printer with ESC ? at startup and believe the answer. This needs the
    //           printer-to-PC data line (Mini-DIN-8 pin 5 wired to the PC's RxD); most Mac-to-PC
    //           cables do not have it, and without an answer Auto falls back to Black.
    // Change this to Black if you have a black ribbon, then re-run add-printer.ps1 so
    // Windows re-reads the printer's capabilities.
    "Ribbon": "Color",

    "Encoder": {
      // Print graphics in both directions (faster, slight risk of 1/144" mis-registration).
      "Bidirectional": false,
      // Inches from the paper's left edge to the print head's first dot column. 0.25 for letter paper
      // loaded against the standard paper guide. Increase if output sits too far left, decrease if too far right.
      "LeftEdgeOffsetInches": 0.25,
      // Extra feed before the first band when the paper's top edge sits above the head at top-of-form.
      "TopEdgeOffsetInches": 0.0,
      "UseHeadPositioning": true,
      "MinRepeatRun": 8,
      "MinSkipRun": 8,
      "PreferGroupedGraphics": true,
      // PerBand: all colours for each 1/9" band before feeding (exact registration).
      // PerPage: whole page per colour with reverse feeds between (tractor paper only).
      "ColorStrategy": "PerBand",
      "SetTopOfFormAtJobStart": true,
      // Tractor paper that gets torn off after every job: distance from the print head to the tear edge.
      // Each job winds the paper back this far before printing and runs it forward again afterwards, so the
      // perforation ends up at the tear edge and the next job still starts at the top of a sheet.
      // Load paper with the top of the sheet at the tear edge, which is also where tearing leaves it.
      // 0 disables it. 2.0 is the measured sweet spot on a real ImageWriter II: far enough past the tear
      // edge to tear cleanly. Do not use however far down a print currently starts, that measures your hand
      // pull rather than the printer. See docs/hardware-setup.md for how to measure it properly.
      "TearOffInches": 0.0
    },

    "Halftone": {
      // FloydSteinberg | Ordered | Threshold
      "Mode": "FloydSteinberg",
      // Dot-gain compensation: >1 lightens mid-tones (the printer's dots are much bigger than the grid). 1.0 = off.
      "Gamma": 1.8,
      "WhiteClip": 0.03,
      "BlackClip": 0.97
    },

    // Plain-text jobs use the printer's own fonts.
    "Text": {
      // Draft | Correspondence | NearLetterQuality
      "Font": "Correspondence",
      // Extended | Pica | Elite | Semicondensed | Condensed | Ultracondensed | PicaProportional | EliteProportional
      "Pitch": "Pica",
      "LinesPerInch": 6,
      "TabWidth": 8,
      "PerforationSkip": true,
      "FormFeedAtEnd": true,
      "Bidirectional": true,
      "WrapColumn": 0
    },

    // Resolutions offered to clients. Horizontal: 72, 80, 96, 107, 120, 136, 144 or 160. Vertical: 72 or 144.
    "Resolutions": [ "72x72", "144x144", "160x144" ],
    "DefaultResolution": "144x144",

    "MediaSupported": [
      "na_letter_8.5x11in",
      "na_legal_8.5x14in",
      "iso_a4_210x297mm",
      "na_executive_7.25x10.5in",
      "na_invoice_5.5x8.5in",
      "iso_a5_148x210mm",
      "na_index-4x6_4x6in"
    ],
    "MediaDefault": "na_letter_8.5x11in",
    "MediaMin": "custom_min_2x2in",
    "MediaMax": "custom_max_8.5x17in",

    // Unprintable margins reported to clients (inches). The head cannot reach the outer 1/4" of letter paper.
    "MarginLeftInches": 0.25,
    "MarginRightInches": 0.25,
    "MarginTopInches": 0.25,
    "MarginBottomInches": 0.25,

    "SpoolDirectory": "spool",
    "KeepCompletedJobs": 50,
    "IdentifyWithBell": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
